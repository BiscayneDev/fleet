# Fleet environment configuration (optional)
#
# Without a .env.local file, Fleet runs against a built-in mock LLM adapter
# and works out of the box -- no API key required.
#
# Copy this file to .env.local only when you want live LLM enrichment:
#   cp .env.local.example .env.local
# Then fill in LLM_WIKI_API_KEY and restart the dev server.

# Adapter: "mock" (default, no key needed) or "real" (live enrichment)
LLM_WIKI_ADAPTER=real

# API key for the LLM provider (Nous Research or any OpenAI-compatible endpoint)
LLM_WIKI_API_KEY=sk-pro-...

# Model to use (default: deepseek-v3)
LLM_WIKI_MODEL=deepseek-v3

# OpenAI-compatible base URL (default: Nous Research)
LLM_WIKI_BASE_URL=https://inference-api.nousresearch.com/v1

# Override where Fleet stores projects, wikis, inbox, and network data
# Defaults to ./data relative to the project root
# FLEET_DATA_ROOT=/absolute/path/to/data
