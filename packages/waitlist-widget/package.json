{
  "name": "fleet-waitlist-widget",
  "version": "0.1.0",
  "description": "Drop-in React waitlist form for Fleet. Posts submissions to your server, which forwards to fleet-waitlist-submit and commits to your vault.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "fleet",
    "waitlist",
    "react",
    "form",
    "obsidian",
    "vault",
    "gtm"
  ],
  "author": "Halsey Huth <halsey.huth@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BiscayneDev/fleet.git",
    "directory": "packages/waitlist-widget"
  },
  "homepage": "https://github.com/BiscayneDev/fleet/tree/main/packages/waitlist-widget#readme",
  "engines": {
    "node": ">=20.9.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19",
    "react": "^19",
    "typescript": "^5"
  }
}
